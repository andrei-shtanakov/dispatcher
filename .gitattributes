# Декларация generated-файлов — SSOT для codex-review-кита (вендорен из
# steward, scripts/review/): пути с linguist-generated опускаются из дифа
# ревью именованным маркером и проверяются на согласованность с источником
# по дереву, не построчно. Тот же атрибут понимает сам GitHub.
# Действует только ВЛИТАЯ декларация (добавление — со следующего PR после
# мержа, снятие — сразу): объявить файл generated и спрятать его тем же
# патчем нельзя. Не объявлено — ревьюируется построчно.
uv.lock linguist-generated=true
# Вендоренные пиненые копии контрактов (plan-fields v3, epics/v1): байты
# проверяет манифест-хэш (tests/test_pf6_drift.py), построчное ревью копии
# живёт у канона (prograph-vault), не здесь. Правится только ре-вендором.
packages/plan-fields/src/plan_fields/contract/** linguist-generated=true
packages/plan-fields/src/plan_fields/contract_epics/** linguist-generated=true
