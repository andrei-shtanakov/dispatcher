{
  "components": {
    "schemas": {
      "BenchmarkResponse": {
        "description": "Schema for returning a benchmark.",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "family_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family Tag"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "tasks_count": {
            "title": "Tasks Count",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "tasks_count",
          "tags",
          "version",
          "family_tag",
          "created_at"
        ],
        "title": "BenchmarkResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunStatusResponse": {
        "description": "Schema for detailed run status with completed tasks.",
        "properties": {
          "completed_tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskResultResponse"
            },
            "title": "Completed Tasks",
            "type": "array"
          },
          "current_task_index": {
            "title": "Current Task Index",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "score_components": {
            "additionalProperties": true,
            "title": "Score Components",
            "type": "object"
          },
          "score_semantics": {
            "additionalProperties": true,
            "title": "Score Semantics",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tasks_count": {
            "title": "Tasks Count",
            "type": "integer"
          },
          "total_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Score"
          }
        },
        "required": [
          "id",
          "status",
          "current_task_index",
          "tasks_count",
          "total_score",
          "score_semantics",
          "score_components",
          "completed_tasks"
        ],
        "title": "RunStatusResponse",
        "type": "object"
      },
      "TaskResultResponse": {
        "description": "Schema for returning a single task result.",
        "properties": {
          "eval_results": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eval Results"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "task_index": {
            "title": "Task Index",
            "type": "integer"
          }
        },
        "required": [
          "task_index",
          "score",
          "eval_results"
        ],
        "title": "TaskResultResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
