          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "atp__dashboard__benchmark__schemas__LeaderboardEntry": {
        "description": "Schema for a leaderboard row.",
        "properties": {
          "agent_name": {
            "title": "Agent Name",
            "type": "string"
          },
          "best_score": {
            "title": "Best Score",
            "type": "number"
          },
          "run_count": {
            "title": "Run Count",
            "type": "integer"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "agent_name",
          "best_score",
          "run_count"
        ],
        "title": "LeaderboardEntry",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/auth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "ATP Dashboard",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/benchmarks": {
      "get": {
        "description": "List all benchmarks.",
        "operationId": "list_benchmarks_api_v1_benchmarks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BenchmarkResponse"
                  },
                  "title": "Response List Benchmarks Api V1 Benchmarks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Benchmarks",
        "tags": [
          "benchmarks"
        ]
      }
    },
    "/api/v1/benchmarks/{benchmark_id}/leaderboard": {
      "get": {
        "description": "Get best scores per agent for a benchmark.",
        "operationId": "get_leaderboard_api_v1_benchmarks__benchmark_id__leaderboard_get",
        "parameters": [
          {
            "in": "path",
            "name": "benchmark_id",
            "required": true,
            "schema": {
              "title": "Benchmark Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/atp__dashboard__benchmark__schemas__LeaderboardEntry"
                  },
                  "title": "Response Get Leaderboard Api V1 Benchmarks  Benchmark Id  Leaderboard Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Leaderboard",
        "tags": [
          "benchmarks"
        ]
      }
    },
    "/api/v1/runs/{run_id}/status": {
      "get": {
        "description": "Get run status with completed tasks (owner-only).",
        "operationId": "get_run_status_api_v1_runs__run_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Run Status",
        "tags": [
          "benchmarks"
        ]
      }
    }
  }
}
