{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:impresario:contract:gate-decision:v1",
  "title": "GateDecision",
  "description": "Immutable запись решения гейта (docs/semantics.md, GateDecision). Authority — человек (schema-enforced: decided_by.kind = human). Исправление/перекрытие — только новой записью со ссылкой supersedes; старая запись не правится.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "gate_id",
    "subject",
    "decision",
    "decided_by",
    "decided_at",
    "reason"
  ],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^GD-[0-9]{3,}$" },
    "gate_id": { "enum": ["qg4_backlog", "qg5_business", "qg5_committee", "process"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "version"],
      "properties": {
        "kind": { "enum": ["product_proposal", "ranked_backlog"] },
        "ref": {
          "type": "string",
          "pattern": "^(proposal://PP-[0-9]{3,}|backlog://BL-[a-z0-9][a-z0-9-]*)$"
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "decision": {
      "enum": ["approve", "recycle", "hold", "kill", "resume", "select", "defer", "park", "reject"]
    },
    "selected_idea_ref": { "type": "string", "pattern": "^idea://IDEA-[0-9]{3,}$" },
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "human" },
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "decided_at": { "$ref": "#/$defs/timestamp" },
    "reason": { "type": "string", "minLength": 1 },
    "required_changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "return_to": { "enum": ["in_iteration", "ready_for_business", "business_approved"] },
    "review_after": { "$ref": "#/$defs/timestamp" },
    "supersedes": { "type": "string", "pattern": "^gate-decision://GD-[0-9]{3,}$" },
    "artifacts_reviewed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "recycle" } } },
      "then": {
        "required": ["return_to", "required_changes"],
        "properties": { "required_changes": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "resume" } } },
      "then": { "required": ["return_to"] }
    },
    {
      "if": {
        "properties": { "gate_id": { "enum": ["qg5_business", "qg5_committee", "process"] } }
      },
      "then": {
        "properties": {
          "subject": { "properties": { "kind": { "const": "product_proposal" } } },
          "decision": { "enum": ["approve", "recycle", "hold", "kill", "resume"] }
        }
      }
    },
    {
      "if": { "properties": { "gate_id": { "const": "qg4_backlog" } } },
      "then": {
        "properties": {
          "subject": { "properties": { "kind": { "const": "ranked_backlog" } } },
          "decision": { "enum": ["select", "defer", "park", "reject"] }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "select" } } },
      "then": { "required": ["selected_idea_ref"] }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
