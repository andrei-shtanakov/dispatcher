{
  "$defs": {
    "Branch": {
      "description": "A git branch.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Branch",
      "type": "object"
    },
    "CopilotReview": {
      "description": "Summary of GitHub Copilot's review on a pull request.",
      "properties": {
        "state": {
          "title": "State",
          "type": "string"
        },
        "comment_count": {
          "title": "Comment Count",
          "type": "integer"
        }
      },
      "required": [
        "state",
        "comment_count"
      ],
      "title": "CopilotReview",
      "type": "object"
    },
    "EpicClassification": {
      "description": "The normalized per-artifact object of classification.schema.json.",
      "properties": {
        "epic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Epic"
        },
        "defect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Defect"
        },
        "classification": {
          "enum": [
            "tagged",
            "missing",
            "invalid",
            "unavailable"
          ],
          "title": "Classification",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/EpicDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "subject_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Uri"
        },
        "carrier": {
          "enum": [
            "pull_request",
            "issue"
          ],
          "title": "Carrier",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        }
      },
      "required": [
        "epic",
        "defect",
        "classification",
        "diagnostics",
        "subject_uri",
        "carrier",
        "observed_at"
      ],
      "title": "EpicClassification",
      "type": "object"
    },
    "EpicDiagnostic": {
      "description": "One instance of a diagnostics.yaml code, with its COMPUTED severity.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "subject_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Uri"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "EpicDiagnostic",
      "type": "object"
    },
    "IssueV2": {
      "description": "An open issue (pull requests excluded) with its classification.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "epic": {
          "$ref": "#/$defs/EpicClassification"
        }
      },
      "required": [
        "number",
        "title",
        "author",
        "epic"
      ],
      "title": "IssueV2",
      "type": "object"
    },
    "LocalStatus": {
      "description": "State of a local clone relative to its upstream.",
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Branch"
        },
        "ahead": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ahead"
        },
        "behind": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Behind"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "branch",
        "ahead",
        "behind",
        "dirty"
      ],
      "title": "LocalStatus",
      "type": "object"
    },
    "MergedPrWindow": {
      "description": "Attribution transport for robin; dispatcher must not read it as state.\n\n`truncated` is explicit so a cut-off window is never mistaken for an\nempty one: True means merged PRs inside the window may exist unseen.",
      "properties": {
        "window_days": {
          "title": "Window Days",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "prs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MergedPullRequest"
          },
          "title": "Prs",
          "type": "array"
        }
      },
      "required": [
        "window_days",
        "truncated"
      ],
      "title": "MergedPrWindow",
      "type": "object"
    },
    "MergedPullRequest": {
      "description": "One merged PR of the attribution window: `commit \u2192 PR` without\nheuristics \u2014 the SHAs are the projection, never the `#123` convention.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "merge_commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Merge Commit Sha"
        },
        "commit_shas": {
          "items": {
            "type": "string"
          },
          "title": "Commit Shas",
          "type": "array"
        },
        "commit_shas_truncated": {
          "title": "Commit Shas Truncated",
          "type": "boolean"
        },
        "merged_at": {
          "format": "date-time",
          "title": "Merged At",
          "type": "string"
        },
        "epic": {
          "$ref": "#/$defs/EpicClassification"
        }
      },
      "required": [
        "number",
        "merge_commit_sha",
        "commit_shas",
        "commit_shas_truncated",
        "merged_at",
        "epic"
      ],
      "title": "MergedPullRequest",
      "type": "object"
    },
    "PullRequestV2": {
      "description": "An open pull request with its epics/v1 classification.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "head_branch": {
          "title": "Head Branch",
          "type": "string"
        },
        "is_dependabot": {
          "title": "Is Dependabot",
          "type": "boolean"
        },
        "copilot_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CopilotReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epic": {
          "$ref": "#/$defs/EpicClassification"
        }
      },
      "required": [
        "number",
        "title",
        "author",
        "head_branch",
        "is_dependabot",
        "epic"
      ],
      "title": "PullRequestV2",
      "type": "object"
    },
    "RepoSnapshotV2": {
      "description": "One workspace repository: local git state plus optional GitHub state.",
      "properties": {
        "dir": {
          "title": "Dir",
          "type": "string"
        },
        "remote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remote"
        },
        "local": {
          "$ref": "#/$defs/LocalStatus"
        },
        "github": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoStateV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dir",
        "remote",
        "local"
      ],
      "title": "RepoSnapshotV2",
      "type": "object"
    },
    "RepoStateV2": {
      "description": "Everything the snapshot publishes about one repository (v2).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pulls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PullRequestV2"
          },
          "title": "Pulls",
          "type": "array"
        },
        "issues": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/IssueV2"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issues"
        },
        "branches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Branch"
          },
          "title": "Branches",
          "type": "array"
        },
        "alerts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alerts"
        },
        "rulesets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RulesetInfo"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rulesets"
        },
        "merged": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergedPrWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "local": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "RepoStateV2",
      "type": "object"
    },
    "RulesetInfo": {
      "description": "Item of GET repos/{r}/rulesets.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "enforcement": {
          "title": "Enforcement",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "enforcement",
        "target"
      ],
      "title": "RulesetInfo",
      "type": "object"
    }
  },
  "description": "Full fleet state, contract v2.\n\nThe JSON shape is a frozen contract (`contracts/snapshot/v2/`): consumers\nkey off `schema_version`, and any breaking change must ship as v3\nalongside v2 \u2014 never as an edit to v2.",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace": {
      "format": "path",
      "title": "Workspace",
      "type": "string"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "gh_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gh Error"
    },
    "repos": {
      "items": {
        "$ref": "#/$defs/RepoSnapshotV2"
      },
      "title": "Repos",
      "type": "array"
    }
  },
  "required": [
    "workspace",
    "host",
    "generated_at",
    "gh_error",
    "repos"
  ],
  "title": "WorkspaceSnapshotV2",
  "type": "object"
}
