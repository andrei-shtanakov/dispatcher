{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecosystem:plan-fields:v2:schema",
  "title": "plan-fields v2 — canonical parser output",
  "description": "The canonical JSON a plan-fields parser emits over a fleet snapshot. contract_version identifies the plan-fields contract; schema_version identifies this envelope shape. References carry every extracted @blocked_by (raw/legacy/unresolved); only resolved canonical todo:// -> todo:// relations appear in edges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "generated_at",
    "nodes",
    "references",
    "edges",
    "diagnostics"
  ],
  "properties": {
    "contract_version": { "const": 2 },
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/OperationalNode" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/Reference" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/Edge" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } }
  },
  "$defs": {
    "RepoName": {
      "type": "string",
      "description": "canonical repo name — the workspace-manifest key, NOT derived from the origin URL",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "ItemId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "TodoUri": {
      "type": "string",
      "pattern": "^todo://[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "CanonicalUri": {
      "type": "string",
      "pattern": "^(todo|roadmap)://[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "line"],
      "properties": {
        "repo": { "$ref": "#/$defs/RepoName" },
        "remote_origin": {
          "type": ["string", "null"],
          "description": "origin URL — kept for cross-check/diagnostics only; NOT the identity source"
        },
        "commit": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "Freshness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "source_ref": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"] },
        "recheck_by": { "type": ["string", "null"] }
      }
    },
    "RawTags": {
      "type": "object",
      "description": "raw parsed tag values exactly as written, so grammar diagnostics never lose the original value",
      "additionalProperties": true
    },
    "OwnerRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "id", "raw"],
      "properties": {
        "kind": {
          "enum": ["github_user", "github_team", "repository", "tbd"]
        },
        "id": { "type": ["string", "null"] },
        "raw": { "type": "string" }
      },
      "description": "Typed accountable principal parsed from operational @owner; null for missing, invalid, or transitional DEC-007 role values"
    },
    "OperationalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "id",
        "repo",
        "title",
        "declared_status",
        "owner_ref",
        "tombstone",
        "provenance"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/TodoUri" },
        "kind": { "const": "operational_item" },
        "id": { "$ref": "#/$defs/ItemId" },
        "repo": { "$ref": "#/$defs/RepoName" },
        "title": { "type": "string" },
        "declared_status": { "enum": ["open", "closed", "unknown"] },
        "owner_role": {
          "type": ["string", "null"],
          "description": "Transitional DEC-007 role-slug (no @); null for typed owner principals"
        },
        "owner_ref": { "$ref": "#/$defs/OwnerRef" },
        "trigger": { "type": ["string", "null"] },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "tombstone": { "type": "boolean" },
        "raw": { "$ref": "#/$defs/RawTags" },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "every extracted @blocked_by, resolved or not. A resolved reference ALSO appears in edges; a legacy/unresolved one never does.",
      "required": [
        "kind",
        "source_node_id",
        "raw_ref",
        "resolved_target",
        "legacy_blocker_ref",
        "provenance"
      ],
      "properties": {
        "kind": { "const": "blocked_by" },
        "source_node_id": { "$ref": "#/$defs/TodoUri" },
        "raw_ref": {
          "type": "string",
          "description": "the @blocked_by value exactly as written (todo:// or legacy <repo>#<slug>)"
        },
        "resolved_target": {
          "oneOf": [{ "$ref": "#/$defs/CanonicalUri" }, { "type": "null" }]
        },
        "legacy_blocker_ref": {
          "type": ["string", "null"],
          "description": "<repo>#<slug> — set for legacy/unresolved refs; NEVER promoted to a canonical edge"
        },
        "provenance": { "$ref": "#/$defs/Provenance" }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "description": "a resolved canonical relation only (source todo:// -> resolved canonical target)",
      "required": ["kind", "source_node_id", "target_node_id"],
      "properties": {
        "kind": { "const": "blocked_by" },
        "source_node_id": { "$ref": "#/$defs/TodoUri" },
        "target_node_id": { "$ref": "#/$defs/CanonicalUri" }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "description": "severity here is the COMPUTED severity for this instance; diagnostics.yaml holds the default_severity policy and Phase 0b applies escalation history",
      "required": ["code", "severity", "subject_uri", "related_uri", "rule_id", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^PF-[A-Z0-9-]+$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "subject_uri": { "type": ["string", "null"] },
        "related_uri": { "type": ["string", "null"] },
        "rule_id": { "type": ["string", "null"] },
        "message": { "type": "string" },
        "provenance": {
          "oneOf": [{ "$ref": "#/$defs/Provenance" }, { "type": "null" }]
        }
      }
    }
  }
}
